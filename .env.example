# =============================================================================
# DriveHer website — environment configuration
#
# Copy to `.env.local` for local development and set the real values in your
# hosting provider's environment settings for production.
# NEVER commit a file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Site identity (public — inlined into the client bundle)
# -----------------------------------------------------------------------------

# Canonical origin, no trailing slash. Drives canonical URLs, OpenGraph URLs,
# sitemap.xml, robots.txt and the API origin check.
NEXT_PUBLIC_SITE_URL=https://driveher.ng

# Set to "production" on the live site only. Anything else makes robots.txt
# disallow the whole site, so staging and preview builds are never indexed.
NEXT_PUBLIC_SITE_ENV=production


# -----------------------------------------------------------------------------
# Lead delivery — configure ONE of the two options below
# -----------------------------------------------------------------------------

# Option A: Resend (https://resend.com). Simplest path; no SMTP port required.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# LEAD_TO_EMAIL=info@driveher.ng
# LEAD_FROM_EMAIL=DriveHer Website <website@driveher.ng>

# Option B: Webhook. POSTs {lead, meta} as JSON to your CRM, automation tool
# (Zapier / Make / n8n) or your own drive-her API.
# LEAD_WEBHOOK_URL=https://api.example.com/hooks/driveher-leads
# LEAD_WEBHOOK_SECRET=a-long-random-string-sent-as-x-driveher-signature

# With neither set, submissions are validated and logged server-side but not
# delivered anywhere. That is fine for local development, not for production.


# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Extra origins permitted to POST to /api/leads, comma separated. The request's
# own host is always allowed, so this is only needed when a second first-party
# domain proxies onto the same app.
# ALLOWED_ORIGINS=https://www.driveher.ng,https://driveher.com

# Shared rate-limit store. With these set, /api/leads enforces one window
# across every serverless instance instead of one window per instance.
# Create a free database at https://console.upstash.com — no package to install.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxxxxx

# -----------------------------------------------------------------------------
# Content Security Policy extensions (BUILD-time — set before `next build`)
# -----------------------------------------------------------------------------

# The policy is first-party only by default, which will silently block any
# analytics or embed you add. Widen it deliberately, one origin at a time.
# Space-separated values.
# CSP_SCRIPT_SRC=https://www.googletagmanager.com
# CSP_CONNECT_SRC=https://www.google-analytics.com https://region1.google-analytics.com
# CSP_IMG_SRC=https://www.google-analytics.com
# CSP_FRAME_SRC=https://www.youtube-nocookie.com
